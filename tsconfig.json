{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "plugins": [{ "name": "@astrojs/ts-plugin" }],
        "paths": {
            "@layouts/*": ["./src/layouts/*"],
            "@lib/*": ["./src/lib/*"]
        }
    }
}
